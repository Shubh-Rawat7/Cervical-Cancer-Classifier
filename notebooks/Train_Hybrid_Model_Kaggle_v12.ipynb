# Herlev Cervical Cancer Training Notebook

Train the Herlev-only Mamba classifier on Kaggle, save the checkpoints, and download them for the local backend.

## Flow
1. Find the repo and Herlev dataset
2. Install backend requirements
3. Train the model
4. Zip checkpoints for download
5. Copy the downloaded files into `backend/Checkpoints` locally
</VSCode.Cell>
<VSCode.Cell id="#VSC-3bc0f94e" language="python">
import os
import subprocess
import sys
from pathlib import Path

WORK_DIR = Path('/kaggle/working')
CLASS_NAMES = ['Normal', 'CIN1', 'CIN2', 'CIN3', 'Cancer']


def looks_like_repo(root: Path) -> bool:
    return (root / 'backend' / 'train.py').exists() and (root / 'backend' / 'requirements.txt').exists()


REPO_CANDIDATES = [
    WORK_DIR,
    Path.cwd(),
    WORK_DIR / 'repo',
    WORK_DIR / 'Cervical-Cancer-Stage-Classification',
    Path('/kaggle/input/cervical-cancer-stage-classification'),
]
REPO_DIR = next((candidate for candidate in REPO_CANDIDATES if looks_like_repo(candidate)), None)

if REPO_DIR is None:
    raise FileNotFoundError(
        'Repository not found. Upload the project repository to the Kaggle notebook environment and make sure the `backend` folder exists under /kaggle/working or /kaggle/input.'
    )

BACKEND_DIR = REPO_DIR / 'backend'
if not BACKEND_DIR.exists():
    raise FileNotFoundError(f'Backend directory not found: {BACKEND_DIR}')

print('Repo   :', REPO_DIR)
print('Backend:', BACKEND_DIR)

subprocess.check_call([sys.executable, '-m', 'pip', 'install', '-q', '-r', str(BACKEND_DIR / 'requirements.txt')])

for path in (str(REPO_DIR), str(BACKEND_DIR)):
    if path not in sys.path:
        sys.path.insert(0, path)


def is_dataset_root(root: Path) -> bool:
    if not root.exists() or not root.is_dir():
        return False
    if (root / 'train').exists() or (root / 'val').exists() or (root / 'test').exists():
        return True
    return sum((root / cls).exists() for cls in CLASS_NAMES) >= 2


DATA_CANDIDATES = [REPO_DIR / 'data', WORK_DIR / 'data', WORK_DIR, Path.cwd()]
input_root = Path('/kaggle/input')
if input_root.exists():
    for candidate in input_root.iterdir():
        if candidate.is_dir():
            if is_dataset_root(candidate):
                DATA_CANDIDATES.append(candidate)
            for nested in candidate.rglob('*'):
                if nested.is_dir() and is_dataset_root(nested):
                    DATA_CANDIDATES.append(nested)


DATA_DIR = next((candidate for candidate in DATA_CANDIDATES if is_dataset_root(candidate)), None)
if DATA_DIR is None:
    candidate_paths = '\n'.join(str(p) for p in DATA_CANDIDATES)
    raise FileNotFoundError(
        'No Herlev dataset found. Place the dataset under /kaggle/working, /kaggle/working/data, or upload it under /kaggle/input.\nTried:\n' + candidate_paths
    )

print('Data   :', DATA_DIR)
print('Classes:', [cls for cls in CLASS_NAMES if (DATA_DIR / cls).exists()])
</VSCode.Cell>
