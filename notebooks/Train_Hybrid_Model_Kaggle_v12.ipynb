<VSCode.Cell id="#VSC-d8c18323" language="python">
import os
import subprocess
import sys

train_script = BACKEND_DIR / 'train.py'
if not train_script.exists():
    raise FileNotFoundError(f'Training script not found: {train_script}\nMake sure the repository backend is mounted in the Kaggle environment.')

cmd = [
    sys.executable, str(train_script),
    '--data-dir', str(DATA_DIR),
    '--output-dir', str(OUTPUT_DIR),
    '--epochs', str(EPOCHS),
    '--batch-size', str(BATCH_SIZE),
    '--image-size', str(IMAGE_SIZE),
    '--val-split', str(VAL_SPLIT),
    '--backbone', BACKBONE,
    '--undersample', UNDERSAMPLE,
    '--lr', str(LR),
    '--weight-decay', str(WEIGHT_DECAY),
    '--patience', str(PATIENCE),
    '--accumulation-steps', str(ACCUMULATION_STEPS),
    '--workers', str(WORKERS),
    '--seed', str(SEED),
    '--loss-type', LOSS_TYPE,
    '--gamma', str(GAMMA),
    '--beta', str(BETA),
    '--label-smoothing', str(LABEL_SMOOTHING),
    '--activation', ACTIVATION,
    '--dropout', str(DROPOUT),
]

if USE_KFOLD:
    cmd.extend(['--use-kfold', '--k-folds', str(K_FOLDS)])
if ACTIVATION_ABLATION:
    cmd.append('--activation-ablation')

print('Running training command:')
print(' '.join(cmd))
print()

env = os.environ.copy()
env['PYTHONUNBUFFERED'] = '1'
proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, env=env)
for line in proc.stdout:
    print(line, end='')
exit_code = proc.wait()
if exit_code != 0:
    raise RuntimeError(f'Training failed with exit code {exit_code}')
print('Training finished successfully.')
</VSCode.Cell>
<VSCode.Cell id="#VSC-7bfce579" language="python">
import zipfile
from pathlib import Path

artifacts = sorted(p for p in OUTPUT_DIR.iterdir() if p.is_file() and p.suffix in {'.pt', '.json'})
if not artifacts:
    raise FileNotFoundError('No checkpoint artifacts were saved in the output directory.')

print('Saved artifacts:')
for artifact in artifacts:
    print(f'  {artifact.name:<24} {artifact.stat().st_size / 1e6:.1f} MB')

zip_path = Path('/kaggle/working/herlev_backend_checkpoints.zip')
with zipfile.ZipFile(zip_path, 'w', zipfile.ZIP_DEFLATED) as zf:
    for artifact in artifacts:
        zf.write(artifact, arcname=str(Path('backend') / 'Checkpoints' / artifact.name))

print() 
print('Zip file:', zip_path)
print('Download this zip from the Kaggle Output tab, then extract it into your local repo root.')
print('After extraction, the files will be ready under backend/Checkpoints.')
</VSCode.Cell>
<VSCode.Cell id="#VSC-598bc124" language="markdown">
## Local Restore

After downloading `herlev_backend_checkpoints.zip`, extract it into your local project root so the files land in `backend/Checkpoints`.

Then run the app locally:
```bash
uvicorn backend.api.main:app --reload
```
